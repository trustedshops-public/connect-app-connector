VITE_PROXY_API_URL=https://app-proxy.connect.trustedshops.com
VITE_CONFIGURATION_API_URL=https://newgen.connect.trustedshops.com/v1
VITE_MIDDLEWARE_API_URL=https://middleware.connect.trustedshops.com
VITE_EVENT_LIBRARY_URL=https://static-app.connect.trustedshops.com/events/eventsLib.js

VITE_CONTROL_CENTER_STAGE=com

VITE_USE_MOCK_BASELAYER=0

# "Connect with Trusted Shops" stays off until the plugin connections page and
# the connect API are deployed to this stage. See .env.test.
VITE_CC_CONNECT_URL=
VITE_CONNECT_API_URL=

VITE_NAME_OF_APP=NewGen-connector
VITE_VERSION_NUMBER_OF_APP=0.0.1

VITE_NODE_ENV=production

VITE_DEACTIVATE_ALLOWS_EVENTS_BY_ORDER_STATUS=0