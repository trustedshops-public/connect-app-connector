VITE_PROXY_API_URL=https://app-proxy.connect-qa.trustedshops.com
VITE_CONFIGURATION_API_URL=https://newgen.connect-qa.trustedshops.com/v1
VITE_MIDDLEWARE_API_URL=https://middleware.connect-qa.trustedshops.com
VITE_EVENT_LIBRARY_URL=https://static-app.connect-qa.trustedshops.com/events/eventsLib.js
VITE_CONTROL_CENTER_STAGE=site

# "Connect with Trusted Shops": the QA Control Center's plugin connections page
# (tswp-connect-plugin-connections) and the connect API that redeems its
# one-time codes. Until the backend exists that API is the plugin repo's
# mock-server (npm run mock:connect-api), running on this machine; the QA page
# reaches it on localhost too. Leave both empty to show only the client ID and
# secret form.
VITE_CC_CONNECT_URL=https://app.etrusted.site/integrations/plugin-connections
VITE_CONNECT_API_URL=http://localhost:6810/v1


VITE_USE_MOCK_BASELAYER=1

VITE_NAME_OF_APP=etrusted-connector-test
VITE_VERSION_NUMBER_OF_APP=0.0.1

VITE_NODE_ENV=test